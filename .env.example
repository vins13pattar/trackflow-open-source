# Database (local dev via docker-compose)
# ADMIN_DATABASE_URL: owner/superuser — used for migrations + RLS setup only.
# DATABASE_URL: the NON-superuser runtime role (superusers bypass RLS, so the
# app must connect as this role for tenant isolation to be enforced).
ADMIN_DATABASE_URL=postgres://trackflow:trackflow@localhost:5432/trackflow
DATABASE_URL=postgres://trackflow_app:trackflow_app@localhost:5432/trackflow
APP_DB_ROLE=trackflow_app
APP_DB_PASSWORD=trackflow_app

# Redis (local dev) / Upstash (prod)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# API
API_PORT=8787
API_BASE_URL=http://localhost:8787

# Ingest (TCP protocol server)
INGEST_GT06_PORT=5023
INGEST_H02_PORT=5013
INGEST_TELTONIKA_PORT=5027
INGEST_NMEA_PORT=5004
INGEST_QUECLINK_PORT=5073
INGEST_MEITRACK_PORT=5020
# Where the ingest service forwards parsed positions (the API ingest endpoint)
INGEST_SINK_URL=http://localhost:8787/internal/positions
INGEST_SINK_TOKEN=dev-ingest-token-change-me
# Bounded ingest -> API forwarder. Queue saturation sheds new packets instead
# of exhausting memory; per-device capacity prevents noisy-neighbour takeover.
INGEST_SINK_QUEUE_CAPACITY=10000
INGEST_SINK_PER_DEVICE_CAPACITY=32
INGEST_SINK_CONCURRENCY=64
INGEST_SINK_TIMEOUT_MS=5000
INGEST_SINK_MAX_ATTEMPTS=3
INGEST_SINK_RETRY_BASE_MS=100
INGEST_SHUTDOWN_TIMEOUT_MS=15000
# Disable per-connection/per-packet logs during controlled load tests.
INGEST_TRAFFIC_LOG=true

# Ingest health + Prometheus metrics HTTP port (separate from the TCP
# listeners). Probe GET /health and scrape GET /metrics here. Default 9100.
INGEST_HTTP_PORT=9100

# Identity of this ingest instance for the multi-instance presence registry.
# Defaults to FLY_MACHINE_ID / HOSTNAME / a random id. Set explicitly only if
# you run multiple ingest instances and want stable, readable instance ids.
# INGEST_INSTANCE_ID=ingest-mumbai-1
# The presence registry (imei -> instance) uses the shared Upstash store below
# when UPSTASH_REDIS_REST_URL is set; otherwise it is in-memory (single instance).

# Optional MQTT ingest. When set, subscribe to a topic-pattern and decode each
# payload via the matching protocol decoder. Topics: trackflow/<protocol>/<imei>/up
# Example: INGEST_MQTT_URL=mqtt://broker.hivemq.com:1883
INGEST_MQTT_URL=
INGEST_MQTT_TOPIC=trackflow/+/+/up
INGEST_MQTT_USERNAME=
INGEST_MQTT_PASSWORD=

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Map tiles (free): OpenFreeMap demo style by default; override with your own/MapTiler key
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Public host GPS devices connect to (shown in the in-app connection guide)
NEXT_PUBLIC_INGEST_HOST=your-trackflow-host

# ============================================================================
# Production integrations — key-gated. Unset = the feature is disabled or runs
# as a dev no-op. Set these as platform secrets (Fly secrets / Vercel env),
# never commit real values. These belong to the API/ingest unless noted.
# ============================================================================

# Web origin allowed by CORS (your production dashboard URL).
WEB_ORIGIN=http://localhost:3000

# Admin (platform operator): gates the /admin/* plan & rate management API.
# Backend secret only — NOT a Next.js/NEXT_PUBLIC var. Generate: openssl rand -hex 32
ADMIN_API_TOKEN=

# Email (Resend): invites, password reset, email verification, reports.
RESEND_API_KEY=
EMAIL_FROM=TrackFlow <noreply@yourdomain.com>

# SMS (MSG91, India — needs a TRAI DLT-registered sender + templates).
MSG91_API_KEY=
SMS_SENDER=

# WhatsApp (Meta Cloud API) — used by the M5 WhatsApp channel.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Payments (Razorpay). Webhook -> https://<api-host>/internal/billing/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payments (Stripe, intl). Webhook -> https://<api-host>/internal/billing/stripe/
# Subscribe to `checkout.session.completed`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare for SaaS — custom hostnames. When both are set the custom-domain
# endpoint provisions a real CF custom hostname; otherwise it stores the value
# locally and reports a "mock" activation status (so dev work is not blocked).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Object storage (S3-compatible / Cloudflare R2). When set, invoice PDFs +
# scheduled reports are archived here and served via pre-signed URLs.
# R2 endpoint: https://<accountId>.r2.cloudflarestorage.com  ·  region: auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional — when set, public URLs are constructed using this base (use this
# if the bucket is fronted by a custom domain).
S3_PUBLIC_BASE_URL=

# Shared rate-limit store (Upstash Redis REST). Unset = in-memory (single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking (Sentry) — DSN for the API/ingest server-side.
# The web frontend uses NEXT_PUBLIC_SENTRY_DSN (typically the same value, set in
# the web app's deployment env so it's injected at build time).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Prometheus scrape token for GET /metrics. When set, scrapers must send
# `Authorization: Bearer <token>`. In production an unset token refuses the
# scrape (request volumes aren't exposed by default). Generate: openssl rand -hex 32
METRICS_TOKEN=

# Scheduler health + Prometheus metrics HTTP port (long-lived `jobs:scheduler`
# process). Probe GET /health and scrape GET /metrics here. Default 9101.
JOBS_HTTP_PORT=9101

# Ops alert recipients (optional).
INGEST_ALERT_EMAIL=
REPORT_EMAIL=
