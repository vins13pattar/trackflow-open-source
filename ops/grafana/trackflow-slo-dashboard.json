{
  "title": "TrackFlow — SLO Overview",
  "uid": "trackflow-slo",
  "tags": ["trackflow", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate (req/s by status)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"trackflow-api\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API error ratio (5xx %)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.02 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"trackflow-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"trackflow-api\"}[5m])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "title": "API latency p95 (SLO < 300ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"trackflow-api\"}[10m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ingest active connections (by protocol)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "ingest_active_connections",
          "legendFormat": "{{protocol}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Ingest throughput (forwarded fixes/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(ingest_forwarded_total[5m]))",
          "legendFormat": "{{protocol}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ingest decode + sink errors/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "expr": "sum(rate(ingest_decode_errors_total[5m]))", "legendFormat": "decode" },
        { "expr": "sum(rate(ingest_sink_errors_total[5m]))", "legendFormat": "sink" }
      ]
    },
    {
      "id": 7,
      "title": "Scheduler — minutes since last success",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "m" } },
      "targets": [
        {
          "expr": "(time() - max by (job) (job_last_success_timestamp_seconds)) / 60",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Scheduler — job failures/h",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (job) (rate(job_runs_total{status=\"failed\"}[1h]))",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
