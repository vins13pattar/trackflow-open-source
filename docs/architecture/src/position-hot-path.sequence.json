  "cards": [
    {
      "dot": "emerald",
      "title": "Hot path",
      "items": [
        "Decode, admit, then forward — the device socket never blocks on the sink",
        "The forward queue is bounded per device and per process and sheds on overload",
        "One transaction inserts the fix, bumps telemetry and evaluates geofences"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "A self-declared IMEI is never trusted until admission approves it",
        "IMEI to tenant resolution is cross-tenant, so it uses the reviewed system role",
        "Under mTLS the certificate identity must equal the device IMEI"
      ]
    },
    {
      "dot": "orange",
      "title": "Failure isolation",
      "items": [
        "A flaky sink retries from the queue instead of dropping the socket",
        "A duplicate fix hits the (device, fix_time) conflict and fires no second alert",
        "Alert dispatch is fire-and-forget and never blocks the ingest response"
      ]
    }
  ]
