  "cards": [
    {
      "dot": "cyan",
      "title": "Edge and ingest",
      "items": [
        "The only always-on tier — trackers hold TCP sockets open",
        "Six decoders: GT06, H02, Teltonika, NMEA, Queclink, Meitrack",
        "mTLS or private-gateway identity gates every socket before decode"
      ]
    },
    {
      "dot": "emerald",
      "title": "Application and realtime",
      "items": [
        "Hono API is Workers-portable: REST, GraphQL and OpenAPI /docs",
        "recordPosition() de-dupes retransmissions, then evaluates geofences",
        "Redis holds IMEI sessions, presence, rate limits and SSE fan-out"
      ]
    },
    {
      "dot": "rose",
      "title": "Tenancy and scheduled work",
      "items": [
        "Tenant queries run as a NOSUPERUSER NOBYPASSRLS role under RLS",
        "Migrations use ADMIN_DATABASE_URL; cross-tenant paths a system role",
        "apps/jobs handles rollup, retention, subscriptions and weekly reports"
      ]
    }
  ]
