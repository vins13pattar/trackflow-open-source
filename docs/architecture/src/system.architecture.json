        "focus": [
          "trackers",
          "ingest",
          "api",
          "postgres"
        ],
        "note": "A raw tracker frame becomes a tenant-scoped row in the partitioned positions table."
      },
      {
        "id": "realtime",
        "label": "Realtime fan-out",
        "focus": [
          "api",
          "redis",
          "web",
          "mobile"
        ],
        "note": "Redis pub/sub republishes tenant positions so every API replica can serve the SSE stream."
      },
      {
        "id": "async-work",
        "label": "Scheduled work",
        "focus": [
          "jobs",
          "postgres",
          "r2store",
          "notify"
        ],
        "note": "Rollups, retention and reporting run off the hot path on their own scheduler."
      }
    ]
