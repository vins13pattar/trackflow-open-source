  "cards": [
    {
      "dot": "cyan",
      "title": "Two front doors",
      "items": [
        "Browsers enter via Cloudflare: dashboard on Vercel, API on Fly",
        "Raw TCP uses a dedicated IPv4 and skips the proxy",
        "Only ingest is always on; the API keeps two warm replicas"
      ]
    },
    {
      "dot": "emerald",
      "title": "Regional placement",
      "items": [
        "API, ingest and jobs run in bom (Mumbai) near the data services",
        "Postgres and Redis stay in the India region for a local hot path",
        "R2 holds only generated report and export objects"
      ]
    },
    {
      "dot": "amber",
      "title": "Operability",
      "items": [
        "Health and metrics ports are private, scraped over Fly 6PN",
        "Grafana carries the SLO dashboard and burn-rate rules from ops/",
        "All three services share one DSN-gated Sentry transport"
      ]
    }
  ]
