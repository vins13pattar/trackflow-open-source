          "client",
          "edge",
          "authn",
          "principal",
          "withtenant",
          "rows"
        ],
        "note": "A credential becomes a principal, and the principal becomes a transaction-local tenant scope."
      },
      {
        "id": "refusals",
        "label": "Refusals",
        "focus": [
          "authn",
          "denied",
          "principal",
          "throttled"
        ],
        "note": "Missing credentials and exhausted quotas stop before any tenant query runs."
      },
      {
        "id": "reviewed-bypass",
        "label": "Reviewed bypass",
        "focus": [
          "authn",
          "system",
          "rows"
        ],
        "note": "The few genuinely cross-tenant lookups run on a separate, enumerated system identity."
      }
    ],
    "legend": {
