  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Identity",
      "items": [
        "A Bearer JWT with optional TOTP MFA, or a PBKDF2-hashed API key",
        "SAML SSO and SCIM provisioning resolve to the same principal shape",
        "The API-key lookup is cross-tenant, so it runs on the system role"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation",
      "items": [
        "withTenant sets app.tenant_id transaction-locally before any query",
        "Every tenant table carries a policy and FORCE ROW LEVEL SECURITY",
        "The app role is NOSUPERUSER NOBYPASSRLS and cannot promote itself"
      ]
    },
    {
      "dot": "amber",
      "title": "Escape hatches",
      "items": [
        "Migrations run as the database owner via ADMIN_DATABASE_URL",
        "Reviewed cross-tenant paths use SYSTEM_DATABASE_URL and are enumerated",
        "Rate limits and plan quotas are metered per API key and per tenant"
      ]
    }
  ]
}
