{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["ADMIN_DATABASE_URL", "DATABASE_URL", "SYSTEM_DATABASE_URL", "REDIS_URL", "TF_DB_TESTS", "TF_REDIS_TESTS"]
    }
  }
}
